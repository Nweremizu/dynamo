---
import Base from "../layouts/Base.astro";
import { href, strings } from "../i18n";

// Cloudflare serves this for any unknown URL, with a 404 status (wrangler.jsonc).
const t = strings.en;
---

<Base lang="en" title={t.meta.notFoundTitle} page="404" noindex>
  <main id="main" class="missing">
    <p class="code">404</p>
    <h1>{t.meta.notFoundBody}</h1>
    <a class="button primary" href={href("en")}>{t.meta.notFoundLink}</a>
  </main>
</Base>

<style>
  .missing {
    display: grid;
    justify-items: center;
    gap: 16px;
    padding: 160px var(--gutter) 40px;
    text-align: center;
  }

  .code {
    margin: 0;
    color: var(--text-faint);
    font-family: var(--mono);
    font-size: 0.875rem;
    letter-spacing: 0.2em;
  }

  h1 {
    max-width: 20ch;
    margin: 0;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 600;
    letter-spacing: -0.03em;
  }
</style>

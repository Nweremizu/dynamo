---
import social from "../../../docs/social-preview.png";
import icon from "../../../src-tauri/icons/128x128@2x.png";
import pkg from "../../../package.json";
import FooterGlow from "../components/FooterGlow.astro";
import { DOWNLOAD, LINKS, REPO, href, strings, type Lang } from "../i18n";

interface Props {
	lang: Lang;
	title: string;
	page: "" | "privacy";
	/** The home page: the island hangs from the top edge, between the bar's two ends. */
	island?: boolean;
}

const { lang, title, page, island = false } = Astro.props;
const t = strings[lang];
const other = t.otherLang;
const home = href(lang);
// In-page sections, reachable from the privacy page too.
const section = (id: string) => (page ? `${home}#${id}` : `#${id}`);
const canonical = new URL(href(lang, page), Astro.site);
// This page in every language, for the browser-language redirect below.
const pages = Object.fromEntries(
	(Object.keys(strings) as Lang[]).map((l) => [l, href(l, page)]),
);
const columns = [
	{
		title: t.footer.product,
		links: [
			[t.footer.download, DOWNLOAD],
			[t.footer.releases, LINKS.releases],
			[t.footer.privacy, href(lang, "privacy")],
		],
	},
	{
		title: t.footer.resources,
		links: [
			[t.footer.plugins, LINKS.plugins],
			[t.footer.api, LINKS.api],
			[t.footer.issues, LINKS.issues],
		],
	},
	{
		title: t.footer.project,
		links: [
			[t.footer.source, REPO],
			[t.footer.license, LINKS.license],
			[t.footer.basedOn, LINKS.basedOn],
		],
	},
];
---

<!doctype html>
<html lang={t.htmlLang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="light" />
		<!--
			GitHub Pages can't negotiate languages, so the browser does it: on the
			default (English) pages, send visitors to the first language in their
			browser list that the site has. Picking a language in the switch is
			remembered and always wins.
		-->
		<script is:inline define:vars={{ lang, pages }}>
			const KEY = "lang";
			let saved = null;
			try {
				saved = localStorage.getItem(KEY);
			} catch {}
			document.addEventListener("click", (e) => {
				const a = e.target.closest?.("a[hreflang]");
				if (!a) return;
				try {
					localStorage.setItem(KEY, a.hreflang);
				} catch {}
			});

			const pick = () => {
				const ours = Object.keys(pages);
				for (const wanted of navigator.languages ?? [navigator.language]) {
					const w = wanted.toLowerCase();
					const hit =
						ours.find((l) => l === w) ??
						ours.find((l) => l.split("-")[0] === w.split("-")[0]);
					if (hit) return hit;
				}
				return null;
			};

			const target = saved && pages[saved] ? saved : lang === "en" ? pick() : null;
			if (target && target !== lang) {
				location.replace(pages[target] + location.search + location.hash);
			}
		</script>
		<title>{title}</title>
		<meta name="description" content={t.meta.description} />
		<link rel="canonical" href={canonical} />
		<link rel="alternate" hreflang="en" href={new URL(href("en", page), Astro.site)} />
		<link rel="alternate" hreflang="pt-BR" href={new URL(href("pt-br", page), Astro.site)} />
		<link rel="icon" type="image/png" href={icon.src} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={t.meta.description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={new URL(social.src, Astro.site)} />
		<meta name="twitter:card" content="summary_large_image" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500&family=Geist:wght@400;500;600;700&display=swap"
		/>
	</head>
	<body class:list={{ "has-island": island }}>
		<a class="skip" href="#main">Skip to content</a>
		<header class="topbar">
			<div class="topbar-inner">
				<a class="brand" href={home}>
					<img src={icon.src} width="24" height="24" alt="" />
					<span>Dynamo</span>
				</a>
				<nav class="topnav" aria-label={t.nav.label}>
					<a href={section("modules")}>{t.nav.modules}</a>
					<a href={section("looks")}>{t.nav.looks}</a>
					<a href={section("faq")}>{t.nav.faq}</a>
					<a href={REPO}>{t.nav.github}</a>
				</nav>
				<div class="topbar-end">
					<a class="lang" href={href(other.lang, page)} hreflang={other.lang} lang={other.lang}>{other.label}</a>
					<a class="button primary sm" href={DOWNLOAD}>{t.nav.download}</a>
				</div>
			</div>
		</header>

		<slot />

		<footer class="footer">
			<div class="wrap footer-grid">
				<div class="footer-brand">
					<a class="brand" href={home}>
						<img src={icon.src} width="24" height="24" alt="" />
						<span>Dynamo</span>
					</a>
					<p>{t.footer.tagline}</p>
					<p class="footer-meta">
						<a href={LINKS.releases}>{t.footer.version} {pkg.version}</a>
						<span aria-hidden="true">·</span>
						<a href={href(other.lang, page)} hreflang={other.lang} lang={other.lang}>{other.label}</a>
					</p>
				</div>
				{
					columns.map((col) => (
						<div class="footer-col">
							<h2>{col.title}</h2>
							<ul>
								{col.links.map(([label, url]) => (
									<li>
										<a href={url}>{label}</a>
									</li>
								))}
							</ul>
						</div>
					))
				}
			</div>
			<!-- The light take on the glow: it rises from the bottom of the page and fades into it. -->
			<FooterGlow text="Dynamo" logoSrc={icon.src} glowColor="#1f63ff" theme="light" ink="rgba(17, 27, 56, 0.82)">
				<div class="glow-bar">
					<span>© {new Date().getFullYear()} Dynamo</span>
					<a href={LINKS.license}>{t.footer.license}</a>
				</div>
			</FooterGlow>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		/* Plain neutrals; the only color on the page comes from the product. */
		--bg: #fafafa;
		--surface: #ffffff;
		--panel: #f5f5f5;
		--border: #e5e5e5;
		--border-strong: #d4d4d4;
		--text: #0a0a0a;
		--text-dim: #525252;
		--text-faint: #a3a3a3;
		--ring: #a3a3a3;
		--island: #000;
		--radius: 16px;
		--radius-sm: 10px;
		--gutter: clamp(16px, 5vw, 40px);
		--measure: 1120px;
		--font: "Geist", ui-sans-serif, system-ui, "Segoe UI", sans-serif;
		--mono: "Geist Mono", ui-monospace, "Cascadia Code", Consolas, monospace;
		color-scheme: light;
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html {
		-webkit-text-size-adjust: 100%;
		scroll-behavior: smooth;
		/* Section anchors land below nothing: the bar scrolls away with the page. */
		scroll-padding-top: 24px;
	}

	body {
		margin: 0;
		background: var(--bg);
		color: var(--text);
		font-family: var(--font);
		font-size: 1rem;
		line-height: 1.6;
		-webkit-font-smoothing: antialiased;
		overflow-x: hidden;
	}

	img,
	video {
		max-width: 100%;
		height: auto;
		display: block;
	}

	a {
		color: inherit;
	}

	:focus-visible {
		outline: 2px solid var(--ring);
		outline-offset: 2px;
		border-radius: 6px;
	}

	.wrap {
		width: min(var(--measure), 100% - 2 * var(--gutter));
		margin-inline: auto;
	}

	.skip {
		position: absolute;
		left: 12px;
		top: -48px;
		z-index: 10;
		padding: 8px 12px;
		border-radius: 8px;
		background: var(--text);
		color: var(--surface);
		text-decoration: none;
	}

	.skip:focus {
		top: 12px;
	}

	/* --- buttons --------------------------------------------------------------- */

	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		height: 44px;
		padding: 0 18px;
		border: 1px solid var(--border);
		border-radius: 10px;
		background: var(--surface);
		box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
		font-size: 0.9375rem;
		font-weight: 500;
		text-decoration: none;
		white-space: nowrap;
		transition:
			background-color 0.15s ease,
			border-color 0.15s ease,
			transform 0.1s ease;
	}

	.button:hover {
		background: var(--panel);
	}

	.button:active {
		transform: scale(0.98);
	}

	.button.primary {
		border-color: var(--text);
		background: var(--text);
		color: var(--surface);
	}

	.button.primary:hover {
		background: #262626;
	}

	.button.sm {
		height: 34px;
		padding: 0 12px;
		border-radius: 8px;
		font-size: 0.875rem;
	}

	.button svg {
		width: 16px;
		height: 16px;
		flex: none;
	}

	/* --- section heads (devl's eyebrow, title, description) -------------------- */

	.eyebrow {
		margin: 0;
		color: var(--text-dim);
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.section {
		padding-block: clamp(64px, 9vw, 112px);
	}

	.section-head {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 16px 48px;
		margin-bottom: 40px;
	}

	.section-head h2 {
		max-width: 20ch;
		margin: 8px 0 0;
		font-size: clamp(1.75rem, 3.6vw, 2.5rem);
		font-weight: 600;
		line-height: 1.1;
		letter-spacing: -0.03em;
		text-wrap: balance;
	}

	.section-head > p {
		max-width: 40ch;
		margin: 0;
		color: var(--text-dim);
		font-size: 0.9375rem;
		text-wrap: pretty;
	}

	.card {
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--surface);
		box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03);
	}

	kbd {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 34px;
		height: 34px;
		padding: 0 9px;
		border: 1px solid var(--border-strong);
		border-bottom-width: 3px;
		border-radius: 8px;
		background: var(--surface);
		font-family: var(--mono);
		font-size: 0.8125rem;
		font-weight: 500;
	}

	/* --- top bar ---------------------------------------------------------------- */

	.topbar {
		position: absolute;
		inset: 0 0 auto;
		z-index: 3;
	}

	.topbar-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		width: min(1200px, 100% - 2 * var(--gutter));
		height: 64px;
		margin-inline: auto;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		font-weight: 600;
		letter-spacing: -0.01em;
		text-decoration: none;
	}

	.brand img {
		width: 24px;
		height: 24px;
		border-radius: 6px;
	}

	.topnav,
	.topbar-end {
		display: flex;
		align-items: center;
		gap: 4px;
	}

	/* The island hangs in the middle of the bar: the links stay on the left. */
	.topnav {
		margin-right: auto;
	}

	.topnav a,
	.lang {
		padding: 6px 10px;
		border-radius: 8px;
		color: var(--text-dim);
		font-size: 0.875rem;
		text-decoration: none;
		transition: color 0.15s ease;
	}

	.topnav a:hover,
	.lang:hover {
		color: var(--text);
	}

	/* The island grows to 540px for a permission request: only the bar's ends stay clear of it. */
	.has-island .topnav {
		display: none;
	}

	@media (max-width: 1100px) {
		.has-island .lang {
			display: none;
		}
	}

	@media (max-width: 760px) {
		.topnav,
		.lang {
			display: none;
		}
	}

	/* Narrower, the island takes the whole top edge; the footer has every link. */
	@media (max-width: 900px) {
		.has-island .topbar {
			display: none;
		}
	}

	/* --- footer: devl's Mega Footer links over GAIA's Footer Glow (light) ---- */

	.footer {
		margin-top: clamp(56px, 8vw, 96px);
		/* No surface or border: the glow rises out of the page itself. */
		overflow: hidden;
	}

	.footer-grid {
		display: grid;
		grid-template-columns: 1.6fr repeat(3, 1fr);
		gap: 40px;
		padding-top: 48px;
		border-top: 1px solid var(--border);
	}

	.footer-brand p {
		margin: 12px 0 0;
		color: var(--text-dim);
		font-size: 0.9375rem;
	}

	.footer-meta {
		display: flex;
		gap: 8px;
		font-size: 0.875rem !important;
	}

	.footer-meta a,
	.footer-col a {
		color: var(--text-dim);
		text-decoration: none;
		transition: color 0.15s ease;
	}

	.footer-meta a:hover,
	.footer-col a:hover {
		color: var(--text);
	}

	.footer-col h2 {
		margin: 0;
		font-size: 0.8125rem;
		font-weight: 600;
	}

	.footer-col ul {
		display: grid;
		gap: 10px;
		margin: 14px 0 0;
		padding: 0;
		list-style: none;
	}

	.footer-col a {
		font-size: 0.875rem;
	}

	.glow-bar {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 8px 24px;
		width: min(var(--measure), 100%);
		margin-inline: auto;
		color: var(--text);
		font-size: 0.8125rem;
	}

	.glow-bar a {
		color: inherit;
		text-decoration: none;
	}

	.glow-bar a:hover {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	@media (max-width: 760px) {
		.footer-grid {
			grid-template-columns: 1fr 1fr;
		}

		.footer-brand {
			grid-column: 1 / -1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}

		*,
		*::before,
		*::after {
			transition-duration: 0.01ms !important;
			animation-duration: 0.01ms !important;
			animation-iteration-count: 1 !important;
		}
	}
</style>
